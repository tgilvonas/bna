{% trans_default_domain 'frontpages' %}

{% if articles and articles|length %}
    {% for article in articles %}
        <article>
            <h2>
                {{ article.articleTitle|e }}
            </h2>
            <div class="date">
                {{ article.date|date('Y-m-d') }}
            </div>
            <img src="/uploads/articles/{{ article.imgOriginal }}" alt="{{ article.articleTitle|e }}" class="lead-image"/>
            {% if article.hasFullContent %}
                {{ article.intro|raw }}
                <a href="{{ path('article', {'category_slug': article.category.categoryUrl, 'article_slug': article.articleUrl}) }}" class="link-more">
                    {{ 'more'|trans }}...
                </a>
            {% else %}
                {{ article.content|raw }}
            {% endif %}
            <div style="clear: both"></div>
        </article>
    {% endfor %}
    {% if showPagination|default(false) and showPagination %}
        {{ knp_pagination_render(articles) }}
    {% endif %}
{% else %}
    <div class="default-padding">{{ 'there_are_no_articles'|trans }}</div>
{% endif %}
