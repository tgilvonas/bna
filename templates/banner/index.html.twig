{% extends 'admin.html.twig' %}

{% trans_default_domain 'admin' %}

{% block body %}
    <h1>{{ 'banners'|trans }}</h1>
    <div class="mb-3">
        <a href="{{ path('admin_banner_create') }}" class="btn btn-success">{{ 'create'|trans }}</a>
    </div>
    {% if banners and banners|length %}
        <table class="table table-bordered">
            <thead>
            <tr>
                <th>{{ 'ord'|trans }}</th>
                <th>&nbsp;</th>
                <th>URL</th>
                <th>{{ 'active_male'|trans }}</th>
                <th>{{ 'actions'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for banner in banners %}
                <tr>
                    <td>
                        <strong>{{ banner.ord }}</strong>
                    </td>
                    <td>
                        <img src="/uploads/banners/{{ banner.img }}" alt="" />
                    </td>
                    <td>
                        <a href="{{ banner.url }}" target="_blank">{{ banner.url }}</a>
                    </td>
                    <td>
                        {% if banner.published %}
                            <span class="badge rounded-pill bg-success">{{ 'yes'|trans }}</span>
                        {% else %}
                            <span class="badge rounded-pill bg-danger">{{ 'no'|trans }}</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('admin_banner_update', {id: banner.id}) }}" class="btn btn-primary">
                            {{ 'edit'|trans }}
                        </a>
                        <a href="{{ path('admin_banner_delete', {'id': banner.id}) }}" onclick="return confirm('{{ 'are_you_sure_you_want_to_delete'|trans }}');" class="btn btn-danger">
                            {{ 'delete'|trans }}
                        </a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        <div class="pt-3">
            {{ knp_pagination_render(banners) }}
        </div>
    {% else %}
        <div class="default-padding">{{ 'there_are_no_records'|trans }}</div>
    {% endif %}
{% endblock %}
