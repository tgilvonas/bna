{% extends 'admin.html.twig' %}

{% trans_default_domain 'admin' %}

{% block body %}
    <h1>{{ 'articles'|trans }}</h1>
    <div class="mb-3">
        <a href="{{ path('admin_article_create') }}" class="btn btn-success">{{ 'create'|trans }}</a>
    </div>
    <form class="py-3">
        <div class="mb-1">
            <label class="mb-1">{{ 'search_by_words'|trans }}</label>
            <input type="text" name="search_word" class="form-control mb-1" value="{{ searchParams['search_word'] ?? '' }}" />
        </div>
        <div class="row">
            <div class="col-md-6 col-sm-12 mb-1">
                <label class="mb-1">{{ 'category'|trans }}</label>
                <select name="category" class="form-control mb-1">
                    <option value="">{{ 'select'|trans }}</option>
                    {% for category in categories %}
                        <option value="{{ category.id }}" {% if searchParams['category'] is defined and searchParams['category'] == category.id %}selected{% endif %}>
                            {{ category.categoryName }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-6 col-sm-12 mb-1">
                <label class="mb-1">{{ 'published'|trans }}</label>
                <select name="published" class="form-control mb-1">
                    <option value="">{{ 'all'|trans }}</option>
                    <option value="1" {% if searchParams['published'] is defined and searchParams['published'] == 1 %}selected{% endif %}>
                        {{ 'yes'|trans }}
                    </option>
                    <option value="0" {% if searchParams['published'] is defined and searchParams['published'] == 0 %}selected{% endif %}>
                        {{ 'no'|trans }}
                    </option>
                </select>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 col-sm-12 mb-1">
                <label class="mb-1">{{ 'date_from'|trans }}</label>
                <input type="date" name="date_from" class="form-control mb-1" value="{{ searchParams['date_from'] ?? '' }}">
            </div>
            <div class="col-md-6 col-sm-12 mb-1">
                <label class="mb-1">{{ 'date_to'|trans }}</label>
                <input type="date" name="date_to" class="form-control mb-1" value="{{ searchParams['date_to'] ?? '' }}">
            </div>
        </div>
        <div class="text-right">
            <a href="{{ path('admin_article_index') }}" class="btn btn-warning">{{ 'clear_search'|trans }}</a>
            <button type="submit" class="btn btn-primary">{{ 'search'|trans }}</button>
        </div>
    </form>
    {% if articles and articles|length %}
        <table class="table table-bordered">
            <thead>
            <tr>
                <th>{{ 'name'|trans }}</th>
                <th>{{ 'date'|trans }}</th>
                <th>{{ 'category'|trans }}</th>
                <th>{{ 'published'|trans }}</th>
                <th>{{ 'on_first_page'|trans }}</th>
                <th>{{ 'actions'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for article in articles %}
                <tr>
                    <td>
                        {{ article.articleTitle }}
                    </td>
                    <td>
                        {{ article.date|date('Y-m-d') }}
                    </td>
                    <td>{{ article.category.categoryName }}</td>
                    <td>
                        {% if article.published %}
                            <span class="badge rounded-pill bg-success">{{ 'yes'|trans }}</span>
                        {% else %}
                            <span class="badge rounded-pill bg-danger">{{ 'no'|trans }}</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if article.onFirstPage %}
                            <span class="badge rounded-pill bg-success">{{ 'yes'|trans }}</span>
                        {% else %}
                            <span class="badge rounded-pill bg-danger">{{ 'no'|trans }}</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('admin_article_update', {id: article.id}) }}" class="btn btn-primary">
                            {{ 'edit'|trans }}
                        </a>
                        <a href="{{ path('admin_article_delete', {'id': article.id}) }}" onclick="return confirm('{{ 'are_you_sure_you_want_to_delete'|trans }}');" class="btn btn-danger">
                            {{ 'delete'|trans }}
                        </a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        <div class="pt-3">
            {{ knp_pagination_render(articles) }}
        </div>
    {% else %}
        <div class="py-3">{{ 'there_are_no_records'|trans }}</div>
    {% endif %}
{% endblock %}
