{% extends 'admin.html.twig' %}

{% trans_default_domain 'admin' %}

{% block body %}
    {% autoescape false %}
        <script type="text/javascript">
            const articlesByCategory = {{ articlesByCategory|json_encode }};
            const articlesByYear = {{ articlesByYear|json_encode }};
            const articlesByYearLabel = '{{ 'articles_amount'|trans }}';
        </script>
    {% endautoescape %}
    <h1 class="mb-3">{{ 'summary'|trans }}</h1>
    <div class="row">
        <div class="col-md-6 col-sm-12 mb-3">
            <div class="card">
                <div class="card-body">
                    <div>{{ 'published_articles_by_category'|trans }}</div>
                    <canvas id="articles_by_category"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-sm-12 mb-3">
            <div class="card">
                <div class="card-body">
                    <div>{{ 'published_articles_by_year'|trans }}</div>
                    <canvas id="articles_by_year"></canvas>
                </div>
            </div>
        </div>
    </div>
    <script type="text/javascript" src="/assets-dist/backend/charts.js"></script>
{% endblock %}
