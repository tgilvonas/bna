{% extends 'admin.html.twig' %}

{% trans_default_domain 'admin' %}

{% block body %}
    <h1>{{ 'admins'|trans }}</h1>
    <div class="mb-3">
        <a href="{{ path('admin_create') }}" class="btn btn-success">{{ 'create'|trans }}</a>
    </div>
    {% if admins and admins|length %}
        <table class="table table-bordered">
            <thead>
            <tr>
                <th>{{ 'email'|trans }}</th>
                <th>{{ 'actions'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for admin in admins %}
                <tr>
                    <td>
                        {{ admin.email }}
                    </td>
                    <td>
                        <a href="{{ path('admin_update', {id: admin.id}) }}" class="btn btn-primary">
                            {{ 'edit'|trans }}
                        </a>
                        <a href="{{ path('admin_delete', {'id': admin.id}) }}" onclick="return confirm('{{ 'are_you_sure_you_want_to_delete'|trans }}');" class="btn btn-danger">
                            {{ 'delete'|trans }}
                        </a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        <div class="pt-3">
            {{ knp_pagination_render(admins) }}
        </div>
    {% else %}
        <div class="default-padding">{{ 'there_are_no_records'|trans }}</div>
    {% endif %}
{% endblock %}
