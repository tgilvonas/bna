{% extends 'admin.html.twig' %}

{% trans_default_domain 'admin' %}

{% block body %}
<div class="example-wrapper">
    <h1>{{ 'tags'|trans }}</h1>
    <div class="mb-3">
        <a href="{{ path('admin_tag_create') }}" class="btn btn-success">{{ 'create'|trans }}</a>
    </div>
    {% if tags and tags|length %}
        <table class="table table-bordered">
            <thead>
            <tr>
                <th>{{ 'name'|trans }}</th>
                <th>{{ 'articles_published'|trans }}</th>
                <th>{{ 'articles_unpublished'|trans }}</th>
                <th>{{ 'articles_total'|trans }}</th>
                <th>{{ 'actions'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for tag in tags %}
                <tr>
                    <td>{{ tag.tag }}</td>
                    <td>
                        <span class="badge rounded-pill bg-success text-decoration-none">
                            {{ tag.articles_published }}
                        </span>
                    </td>
                    <td>
                        <span class="badge rounded-pill bg-danger text-decoration-none">
                            {{ tag.articles_unpublished }}
                        </span>
                    </td>
                    <td>
                        <span class="badge rounded-pill bg-primary text-decoration-none">
                            {{ tag.articles_total }}
                        </span>
                    </td>
                    <td>
                        <a href="{{ path('admin_tag_update', {id: tag.id}) }}" class="btn btn-primary">
                            {{ 'edit'|trans }}
                        </a>
                        <a href="{{ path('admin_tag_delete', {'id': tag.id}) }}"
                           onclick="return confirm('{{ 'are_you_sure_you_want_to_delete'|trans }}');"
                           class="btn btn-danger"
                        >
                            {{ 'delete'|trans }}
                        </a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        <div class="pt-3">
            {{ knp_pagination_render(tags) }}
        </div>
    {% else %}
        <div class="default-padding">{{ 'there_are_no_records'|trans }}</div>
    {% endif %}
</div>
{% endblock %}
