{% extends 'admin.html.twig' %}

{% trans_default_domain 'admin' %}

{% block body %}
    <h1>{{ 'categories'|trans }}</h1>
    <div class="mb-3">
        <a href="{{ path('admin_category_create') }}" class="btn btn-success">{{ 'create'|trans }}</a>
    </div>
    {% if categories and categories|length %}
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>{{ 'name'|trans }}</th>
                    <th>{{ 'active_female'|trans }}</th>
                    <th>{{ 'articles_published'|trans }}</th>
                    <th>{{ 'articles_unpublished'|trans }}</th>
                    <th>{{ 'articles_total'|trans }}</th>
                    <th>{{ 'actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for category in categories %}
                    <tr>
                        <td>{{ category.categoryName }}</td>
                        <td>
                            {% if category.active %}
                                <span class="badge rounded-pill bg-success">{{ 'yes'|trans }}</span>
                            {% else %}
                                <span class="badge rounded-pill bg-danger">{{ 'no'|trans }}</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('admin_article_index', {'category': category.id, 'published': 1}) }}" class="badge rounded-pill bg-success text-decoration-none">
                                {{ category.articles_published }}
                            </a>
                        </td>
                        <td>
                            <a href="{{ path('admin_article_index', {'category': category.id, 'published': 0}) }}" class="badge rounded-pill bg-danger text-decoration-none">
                                {{ category.articles_unpublished }}
                            </a>
                        </td>
                        <td>
                            <a href="{{ path('admin_article_index', {'category': category.id}) }}" class="badge rounded-pill bg-primary text-decoration-none">
                                {{ category.articles_total }}
                            </a>
                        </td>
                        <td>
                            <a href="{{ path('admin_category_update', {id: category.id}) }}" class="btn btn-primary">
                                {{ 'edit'|trans }}
                            </a>
                            <a href="{{ path('admin_category_delete', {'id': category.id}) }}"
                               onclick="return confirm('{{ 'are_you_sure_you_want_to_delete'|trans }}');"
                               class="btn btn-danger"
                            >
                                {{ 'delete'|trans }}
                            </a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        <div class="pt-3">
            {{ knp_pagination_render(categories) }}
        </div>
    {% else %}
        <div class="default-padding">{{ 'there_are_no_records'|trans }}</div>
    {% endif %}
{% endblock %}
